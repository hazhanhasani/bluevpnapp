ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_THIS_STRONG_PASSWORD
SESSION_SECRET=CHANGE_THIS_LONG_RANDOM_SECRET
DATA_ENCRYPTION_KEY=CHANGE_THIS_OTHER_LONG_RANDOM_SECRET
PUBLIC_BASE_URL=https://bluevpnapp-production.up.railway.app
APP_DISPLAY_TIMEZONE=Asia/Tehran
APP_CALENDAR=jalali
DATABASE_URL=${{ Postgres.DATABASE_PRIVATE_URL }}
BOT_TOKEN=
ADMIN_IDS=
GITHUB_TOKEN=
GITHUB_REPOSITORY=hazhanhasani/bluevpnapp
GIT_BRANCH=main
GITHUB_WORKFLOW=build-apk.yml
APK_URL=
SUPPORT_URL=

# Database Autopilot
DB_REQUIRE_POSTGRES=true
ALLOW_SQLITE_FALLBACK=false
DB_CONNECT_RETRIES=5
DB_CONNECT_RETRY_SECONDS=2
DB_CONNECT_TIMEOUT=8
AUTO_MIGRATE_DATABASE=true
MIGRATE_SQLITE_TO_POSTGRES=true
# DATABASE_URL can also be supplied as DATABASE_PRIVATE_URL or PGHOST/PGUSER/PGPASSWORD/PGDATABASE.

# Bootstrap / startup diagnostics
APP_START_RETRY_SECONDS=15

# Resilient Telegram transport for Railway
TELEGRAM_CONNECT_TIMEOUT=35
TELEGRAM_READ_TIMEOUT=35
TELEGRAM_GET_UPDATES_READ_TIMEOUT=65
TELEGRAM_WRITE_TIMEOUT=35
TELEGRAM_POOL_TIMEOUT=35
TELEGRAM_MEDIA_WRITE_TIMEOUT=180
TELEGRAM_CONNECTION_POOL_SIZE=16
TELEGRAM_GET_UPDATES_CONNECTION_POOL_SIZE=4
TELEGRAM_CONCURRENT_UPDATES=8
TELEGRAM_POLL_TIMEOUT=20
TELEGRAM_BOOTSTRAP_RETRIES=5
TELEGRAM_START_RETRY_SECONDS=10
TELEGRAM_START_RETRY_MAX_SECONDS=120
TELEGRAM_ALERT_AFTER_FAILURES=3

# Admin/session security (v3.0.23)
SESSION_HTTPS_ONLY=true
ADMIN_SESSION_MAX_AGE=43200
TRUST_PROXY_HEADERS=true
AUTH_LOGIN_RATE_LIMIT=12
AUTH_LOGIN_IP_RATE_LIMIT=120
AUTH_LOGIN_WINDOW_SECONDS=600
AUTH_REGISTER_RATE_LIMIT=20
AUTH_REGISTER_WINDOW_SECONDS=3600
ADMIN_LOGIN_RATE_LIMIT=8
ADMIN_LOGIN_WINDOW_SECONDS=900

# BluePay diagnostics
BLUEPAY_ERROR_LOG_PATH=/app/data/bluepay-http-errors.jsonl

# BluePay checkout lifecycle (v3.0.23)
BLUEPAY_PENDING_CLEANUP_ENABLED=true
BLUEPAY_CLEANUP_INTERVAL_SECONDS=300
BLUEPAY_CREATING_GRACE_SECONDS=120
BLUEPAY_ABANDON_GRACE_SECONDS=300
BLUEPAY_INVOICE_TTL_MINUTES=30

# BluePay stale-invoice rejection (v3.0.23)
BLUEPAY_FRESH_INVOICE_RETRIES=2
BLUEPAY_FRESH_INVOICE_MIN_LIFETIME_SECONDS=60
