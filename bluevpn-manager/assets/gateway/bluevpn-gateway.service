[Unit]
Description=BlueVPN Gateway Metering Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/bin/python3 /opt/bluevpn-gateway/agent.py --config /etc/bluevpn-gateway/agent.json
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/etc/bluevpn-gateway /var/lib/bluevpn-gateway /var/log

[Install]
WantedBy=multi-user.target
