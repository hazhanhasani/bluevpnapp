<Window x:Class="BlueVPN.Windows.MainWindow"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BlueVPN" Height="760" Width="620" MinHeight="560" MinWidth="440"
        WindowStartupLocation="CenterScreen" FlowDirection="RightToLeft" FontFamily="Segoe UI"
        Background="{DynamicResource BlueVpnBg}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
    <Grid x:Name="RootGrid" Background="{DynamicResource BlueVpnBg}">

        <!-- Android BlueVpnHomeActivity parity: header → brand → status/orb → metrics → ad → server → entitlement. -->
        <!-- The home surface is one responsive composition, not a document.
             DownOnly keeps normal desktop text pixel-perfect and uniformly fits
             the complete dashboard on short/high-DPI screens without scrolling. -->
        <Viewbox x:Name="HomeFitViewbox" Stretch="Uniform" StretchDirection="DownOnly"
                 HorizontalAlignment="Center" VerticalAlignment="Top">
        <Grid x:Name="HomeContentGrid" Width="584" Margin="10,4,10,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header: account left, version centered, menu right exactly like Android. -->
            <Grid Grid.Row="0" FlowDirection="LeftToRight" MinHeight="44" Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="82"/>
                    <ColumnDefinition Width="60"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" x:Name="AccountButton" Click="AccountButton_Click"
                        Width="44" Height="44" Padding="0" Margin="0" ToolTip="حساب BlueVPN"
                        Background="{DynamicResource BlueVpnSurface}" BorderBrush="{DynamicResource BlueVpnStroke}">
                    <Grid Width="24" Height="24">
                        <Ellipse Width="8" Height="8" Stroke="{DynamicResource BlueVpnTextSecondary}" StrokeThickness="1.8" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,2,0,0"/>
                        <Path Data="M4,21 C4.6,15 8,12.5 12,12.5 C16,12.5 19.4,15 20,21 Z" Stroke="{DynamicResource BlueVpnTextSecondary}" StrokeThickness="1.8" Fill="Transparent" StrokeLineJoin="Round"/>
                    </Grid>
                </Button>
                <TextBlock Grid.Column="2" x:Name="VersionText" Text="6.0.10" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource BlueVpnMuted}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                <Button Grid.Column="3" x:Name="MenuButton" Click="MenuButton_Click"
                        Width="44" Height="44" Padding="0" Margin="0" ToolTip="منو"
                        Background="{DynamicResource BlueVpnSurface}" BorderBrush="{DynamicResource BlueVpnStroke}">
                    <Grid Width="24" Height="20">
                        <Line X1="2" Y1="4" X2="22" Y2="4" Stroke="{DynamicResource BlueVpnTextSecondary}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        <Line X1="2" Y1="10" X2="22" Y2="10" Stroke="{DynamicResource BlueVpnTextSecondary}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        <Line X1="2" Y1="16" X2="22" Y2="16" Stroke="{DynamicResource BlueVpnTextSecondary}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Grid>
                </Button>
            </Grid>

            <!-- Brand block -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,0,0,7">
                <TextBlock Text="BlueVPN" FontSize="32" FontStyle="Italic" FontWeight="Bold"
                           Foreground="{DynamicResource BlueVpnBlue}" HorizontalAlignment="Center"/>
                <TextBlock x:Name="SubscriptionSummaryText" Text="در حال آماده‌سازی حساب" FontSize="12.5"
                           Foreground="{DynamicResource BlueVpnMuted}" HorizontalAlignment="Center"
                           Margin="12,3,12,0" TextAlignment="Center" TextWrapping="Wrap" LineHeight="17"/>
            </StackPanel>

            <!-- Flexible orb stage, mirroring Android createOrbStage(). -->
            <Grid Grid.Row="2" Margin="0,0,0,9">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" FlowDirection="RightToLeft" MinHeight="38">
                    <Ellipse x:Name="StatusDot" Width="11" Height="11" Fill="{DynamicResource BlueVpnMuted}" Margin="0,0,10,0"/>
                    <TextBlock x:Name="StatusText" Text="آماده اتصال" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Grid.Row="1" x:Name="ConnectionStatusText" Text="بهترین اتصال به‌صورت خودکار انتخاب می‌شود"
                           FontSize="12" Foreground="{DynamicResource BlueVpnTextSecondary}" TextAlignment="Center"
                           HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" LineHeight="18"
                           Margin="14,1,14,5"/>

                <Grid Grid.Row="2" Width="330" Height="108" MaxWidth="420" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Border x:Name="OrbHalo" Height="104" CornerRadius="52" VerticalAlignment="Center"
                            BorderBrush="{DynamicResource BlueVpnBlue}" BorderThickness="1.2" Background="{DynamicResource BlueVpnSurfaceSoft}"/>
                    <Border Height="96" CornerRadius="48" Margin="7,4" BorderBrush="{DynamicResource BlueVpnStroke}" BorderThickness="1" Background="{DynamicResource BlueVpnSurface}"/>
                    <!-- Android screenshot: hint on left, power orb on right. -->
                    <Grid Margin="9" FlowDirection="LeftToRight">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="84"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" x:Name="OrbText" Text="برای اتصال لمس کنید" FontSize="16"
                                   FontWeight="SemiBold" Foreground="{DynamicResource BlueVpnTextSecondary}"
                                   VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <Border Grid.Column="1" x:Name="StatusOrb" Width="80" Height="80" CornerRadius="40"
                                Background="{DynamicResource BlueVpnBlue}" BorderBrush="{DynamicResource BlueVpnBlue2}"
                                BorderThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button x:Name="ConnectButton" Click="Connect_Click" Foreground="White" Background="Transparent" BorderThickness="0" Padding="0" Margin="0" ToolTip="اتصال / قطع اتصال">
                                <Grid Width="46" Height="46">
                                    <Path x:Name="PowerArc" Stroke="White" StrokeThickness="4.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Data="M 12,10 A 15,15 0 1 0 34,10" Stretch="Uniform" Margin="4,8,4,3"/>
                                    <Line x:Name="PowerStem" X1="23" Y1="3" X2="23" Y2="21" Stroke="White" StrokeThickness="4.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Grid>
                            </Button>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>

            <!-- Live telemetry: download | duration | upload, same visual order as Android screenshot. -->
            <UniformGrid Grid.Row="3" Columns="3" FlowDirection="LeftToRight" Margin="0,0,0,8" MinHeight="54">
                <Border Style="{DynamicResource BlueVpnMetricCardStyle}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" FlowDirection="RightToLeft">
                        <TextBlock Text="↓  دانلود" FontSize="10.5" Foreground="{DynamicResource BlueVpnMuted}"/>
                        <TextBlock x:Name="DownloadSpeedValue" Text="0 KB/s" FontSize="15" FontWeight="Bold" Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{DynamicResource BlueVpnMetricCardStyle}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="◷  مدت اتصال" FontSize="10.5" Foreground="{DynamicResource BlueVpnMuted}"/>
                        <TextBlock x:Name="DurationValue" Text="00:00:00" FontSize="15" FontWeight="Bold" Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{DynamicResource BlueVpnMetricCardStyle}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" FlowDirection="RightToLeft">
                        <TextBlock Text="↑  آپلود" FontSize="10.5" Foreground="{DynamicResource BlueVpnMuted}"/>
                        <TextBlock x:Name="UploadSpeedValue" Text="0 KB/s" FontSize="15" FontWeight="Bold" Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>
            <TextBlock x:Name="SpeedValue" Text="0 KB/s" Visibility="Collapsed"/>

            <!-- Android-position campaign banner. Network images are loaded off the dispatcher. -->
            <Border Grid.Row="4" x:Name="AdCard" Width="440" MinHeight="116" MaxHeight="220" Background="{DynamicResource BlueVpnAdBg}" CornerRadius="20"
                    HorizontalAlignment="Center" Margin="4,0,4,9" Visibility="Collapsed" MouseLeftButtonUp="AdCard_Click" Cursor="Hand"
                    SizeChanged="AdCard_SizeChanged" ClipToBounds="True" BorderBrush="{DynamicResource BlueVpnStroke}" BorderThickness="1">
                <Grid>
                    <Border x:Name="AdFallbackPanel" Background="{DynamicResource BlueVpnAdBg}">
                        <Grid Margin="18,14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="86"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock x:Name="AdTitle" Text="BlueVPN" Foreground="White" FontSize="16" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="AdSubtitle" Text="پیشنهاد ویژه BlueVPN" Foreground="#FFD5E3FF" FontSize="10.5" Margin="0,6,0,0"
                                           TextWrapping="Wrap" MaxHeight="34"/>
                            </StackPanel>
                            <Border Grid.Column="1" Background="#26356DF1" BorderBrush="#80356DF1" BorderThickness="1" CornerRadius="14" Padding="9,7" VerticalAlignment="Center">
                                <TextBlock x:Name="AdActionText" Text="مشاهده ←" Foreground="White" FontSize="10.5" FontWeight="Bold" TextAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>
                    <Image x:Name="AdImage" Stretch="Uniform" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <Grid x:Name="TapsellWebHost" Visibility="Collapsed" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                    <Border x:Name="TapsellLoadingPanel" Visibility="Collapsed" Background="{DynamicResource BlueVpnAdBg}">
                        <TextBlock Text="در حال دریافت تبلیغ تپسل…" Foreground="#FFD5E3FF" FontSize="11"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Border x:Name="AdProviderLabel" Visibility="Collapsed" Background="#36000100" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="10" CornerRadius="12" Padding="8,4">
                        <TextBlock Text="تبلیغ" Foreground="White" FontSize="9"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Server/location card -->
            <Border Grid.Row="5" x:Name="LocationCard" Background="{DynamicResource BlueVpnSurface}" CornerRadius="24" BorderBrush="{DynamicResource BlueVpnStroke}"
                    BorderThickness="1" Padding="13,8" Margin="4,0,4,8" MinHeight="74" Cursor="Hand"
                    MouseLeftButtonUp="LocationCard_Click" ToolTip="انتخاب لوکیشن">
                <Grid FlowDirection="LeftToRight">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/><ColumnDefinition Width="22"/></Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="≡" FontSize="25" FontWeight="Bold" Foreground="{DynamicResource BlueVpnBlue}"
                               VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    <StackPanel Grid.Column="1" FlowDirection="RightToLeft" VerticalAlignment="Center" Margin="8,0">
                        <TextBlock x:Name="EndpointText" Text="انتخاب خودکار" FontSize="16" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="EngineText" Text="بهترین مسیر همان لوکیشن به‌صورت خودکار انتخاب می‌شود"
                                   FontSize="11.5" Foreground="{DynamicResource BlueVpnTextSecondary}" Margin="0,4,0,0"
                                   TextWrapping="Wrap" LineHeight="17"/>
                        <TextBlock x:Name="ServerStatusText" Text="آماده اتصال" FontSize="10.5"
                                   Foreground="{DynamicResource BlueVpnTextSecondary}" Margin="0,4,0,0"
                                   TextWrapping="Wrap" LineHeight="16"/>
                    </StackPanel>
                    <Ellipse Grid.Column="2" Width="12" Height="12" Fill="{DynamicResource BlueVpnBlue}" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Remaining entitlement row -->
            <Border Grid.Row="6" Background="{DynamicResource BlueVpnSurface}" CornerRadius="20" BorderBrush="{DynamicResource BlueVpnStroke}"
                    BorderThickness="1" Margin="4,0,4,4" Padding="8" MinHeight="52">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="1"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="حجم باقی‌مانده" FontSize="10" Foreground="{DynamicResource BlueVpnMuted}"/>
                        <TextBlock x:Name="RemainingVolumeValue" Text="—" FontSize="14" FontWeight="Bold" Margin="0,3,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="{DynamicResource BlueVpnStroke}" Height="32" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="زمان باقی‌مانده" FontSize="10" Foreground="{DynamicResource BlueVpnMuted}"/>
                        <TextBlock x:Name="RemainingTimeValue" Text="—" FontSize="14" FontWeight="Bold" Margin="0,3,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Internal fields retained for diagnostics/menu only. -->
            <StackPanel Visibility="Collapsed">
                <TextBlock x:Name="TierText" Text="Free"/><TextBlock x:Name="IpValue" Text="—"/>
                <TextBlock x:Name="PingValue" Text="—"/><TextBlock x:Name="LocationBadge" Text="AUTO"/>
                <TextBlock x:Name="TechnicalText"/><TextBlock x:Name="RuntimeBadge" Text="BlueVPN Core"/>
                <TextBlock x:Name="FooterStatus" Text="آماده"/>
            </StackPanel>
        </Grid>
        </Viewbox>

        <!-- Connecting overlay mirrors Android: full home takeover, explicit cancel, no frozen UI. -->
        <Grid x:Name="ConnectingOverlay" Visibility="Collapsed" Background="{DynamicResource BlueVpnBg}" Panel.ZIndex="15">
            <Grid MaxWidth="460" Margin="22,18">
                <Grid.RowDefinitions><RowDefinition Height="54"/><RowDefinition Height="*"/><RowDefinition Height="72"/></Grid.RowDefinitions>
                <Grid Grid.Row="0" FlowDirection="LeftToRight">
                    <Button Content="لغو" Click="CancelConnection_Click" Width="82" Height="42" HorizontalAlignment="Left"/>
                    <TextBlock Text="BlueVPN" Foreground="{DynamicResource BlueVpnBlue}" FontWeight="Bold" FontSize="15"
                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
                <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Width="360">
                    <Ellipse Width="190" Height="190" Stroke="#50356DF1" StrokeThickness="18" Fill="#16356DF1"/>
                    <TextBlock Text="در حال اتصال" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,18,0,0"/>
                    <TextBlock x:Name="ConnectingStageText" Text="در حال انتخاب بهترین اتصال" FontSize="12.5"
                               Foreground="{DynamicResource BlueVpnMuted}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0"/>
                </StackPanel>
                <Border Grid.Row="2" Background="{DynamicResource BlueVpnSurface}" CornerRadius="18" BorderBrush="{DynamicResource BlueVpnStroke}" BorderThickness="1" Padding="12">
                    <TextBlock Text="فقط اتصال تأییدشده نمایش داده می‌شود؛ مسیر ناموفق خودکار تعویض خواهد شد."
                               FontSize="10.5" Foreground="{DynamicResource BlueVpnTextSecondary}" TextAlignment="Center" TextWrapping="Wrap"/>
                </Border>
            </Grid>
        </Grid>

        <!-- Account drawer -->
        <!-- 5.2.2: full-density safe layout for 100/125/150% Windows scaling. -->
        <Grid x:Name="AccountDrawer" Visibility="Collapsed" Background="{DynamicResource BlueVpnOverlay}" Panel.ZIndex="20">
            <Border Width="440" MaxWidth="440" HorizontalAlignment="Left" VerticalAlignment="Stretch" Background="{DynamicResource BlueVpnBg}"
                    Padding="22" BorderBrush="{DynamicResource BlueVpnStroke}" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                    <StackPanel Margin="0,0,6,0">
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="حساب BlueVPN" FontSize="23" FontWeight="Bold"/>
                                <TextBlock Text="ورود، اشتراک و پلن‌های ویژه" FontSize="11.5" Foreground="{DynamicResource BlueVpnTextSecondary}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="✕" Click="CloseDrawers_Click" Width="42" Height="42" Padding="0" Margin="8,0,0,0"/>
                        </Grid>

                        <StackPanel x:Name="LoginPanel">
                            <Border Background="{DynamicResource BlueVpnSurface}" CornerRadius="22" Padding="18" BorderBrush="{DynamicResource BlueVpnStroke}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="ورود امن به BlueVPN" Foreground="{DynamicResource BlueVpnText}" FontSize="19" FontWeight="SemiBold" TextAlignment="Center"/>
                                    <TextBlock x:Name="AuthHintText" Text="ورود امن با کد یک‌بارمصرف ۶ رقمی" Foreground="{DynamicResource BlueVpnTextSecondary}" FontSize="12"
                                               TextAlignment="Center" TextWrapping="Wrap" LineHeight="19" Margin="8,8,8,16"/>

                                    <Grid FlowDirection="LeftToRight" Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" x:Name="SmsModeButton" Content="پیامک" Click="AuthSmsMode_Click" Height="40" Margin="0,0,4,0"
                                                Background="{DynamicResource BlueVpnSurfaceStrong}" Foreground="{DynamicResource BlueVpnBlue2}" BorderBrush="#FFB9C9F4" FontWeight="Bold"/>
                                        <Button Grid.Column="1" x:Name="EmailModeButton" Content="ایمیل" Click="AuthEmailMode_Click" Height="40" Margin="4,0,0,0"
                                                Background="{DynamicResource BlueVpnBg}" Foreground="{DynamicResource BlueVpnTextSecondary}" BorderBrush="{DynamicResource BlueVpnStroke}" FontWeight="Bold"/>
                                    </Grid>

                                    <Border Background="{DynamicResource BlueVpnSurfaceStrong}" CornerRadius="18" BorderBrush="{DynamicResource BlueVpnStroke}" BorderThickness="1" Padding="16">
                                        <Grid>
                                            <StackPanel x:Name="SmsAuthPanel">
                                                <StackPanel x:Name="SmsPhoneStage">
                                                    <TextBlock Text="ورود به حساب کاربری" Foreground="{DynamicResource BlueVpnText}" FontSize="17" FontWeight="SemiBold"/>
                                                    <TextBlock Text="شماره موبایل خود را وارد کنید تا کد ورود ۶ رقمی برایتان ارسال شود."
                                                               Foreground="{DynamicResource BlueVpnTextSecondary}" FontSize="12" TextWrapping="Wrap" LineHeight="19" Margin="0,8,0,16"/>
                                                    <TextBlock Text="شماره موبایل" Foreground="{DynamicResource BlueVpnMuted}" FontSize="11.5" FontWeight="SemiBold"/>
                                                    <TextBox x:Name="PhoneBox" FlowDirection="LeftToRight" TextAlignment="Left" MaxLength="14"
                                                             Background="{DynamicResource BlueVpnSurface}" Foreground="{DynamicResource BlueVpnText}" BorderBrush="{DynamicResource BlueVpnStroke}" CaretBrush="{DynamicResource BlueVpnBlue}"
                                                             FontSize="14" Padding="12,9" Margin="0,7,0,9"/>
                                                    <Button Content="ارسال کد ورود" Click="RequestOtp_Click" Height="44" Margin="0,10,0,0"
                                                            Background="{DynamicResource BlueVpnBlue}" Foreground="White" BorderBrush="{DynamicResource BlueVpnBlue2}" FontWeight="SemiBold"/>
                                                </StackPanel>

                                                <StackPanel x:Name="SmsOtpStage" Visibility="Collapsed">
                                                    <Button Content="→  تغییر شماره" Click="ChangePhone_Click" HorizontalAlignment="Left" Margin="0,0,0,10"
                                                            Background="Transparent" Foreground="{DynamicResource BlueVpnBlue2}" BorderBrush="Transparent" Padding="4" FontWeight="Bold"/>
                                                    <TextBlock Text="کد تأیید را وارد کنید" Foreground="{DynamicResource BlueVpnText}" FontSize="17" FontWeight="SemiBold"/>
                                                    <TextBlock x:Name="OtpTargetText" Text="کد ۶ رقمی ارسال‌شده را وارد کنید."
                                                               Foreground="{DynamicResource BlueVpnTextSecondary}" FontSize="12" TextWrapping="Wrap" LineHeight="19" Margin="0,8,0,15"/>
                                                    <TextBox x:Name="OtpBox" FlowDirection="LeftToRight" TextAlignment="Center" MaxLength="6"
                                                             Background="{DynamicResource BlueVpnSurface}" Foreground="{DynamicResource BlueVpnText}" BorderBrush="{DynamicResource BlueVpnStroke}" CaretBrush="{DynamicResource BlueVpnBlue}"
                                                             FontSize="22" FontWeight="SemiBold" CharacterCasing="Upper" Padding="12,9" Margin="0,0,0,8"/>
                                                    <Button Content="تأیید و ورود" Click="VerifyOtp_Click" Height="44" Margin="0,10,0,0"
                                                            Background="{DynamicResource BlueVpnBlue}" Foreground="White" BorderBrush="{DynamicResource BlueVpnBlue2}" FontWeight="SemiBold"/>
                                                    <Button Content="کد را دریافت نکردید؟  ارسال مجدد" Click="ResendOtp_Click" Height="40" Margin="0,9,0,0"
                                                            Background="Transparent" Foreground="{DynamicResource BlueVpnBlue2}" BorderBrush="Transparent"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <StackPanel x:Name="EmailAuthPanel" Visibility="Collapsed">
                                                <Grid FlowDirection="LeftToRight" Margin="0,0,0,15">
                                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                                    <Button Grid.Column="0" x:Name="EmailLoginModeButton" Content="ورود" Click="EmailLoginMode_Click" Height="40" Margin="0,0,4,0"
                                                            Background="{DynamicResource BlueVpnSurfaceStrong}" Foreground="{DynamicResource BlueVpnBlue2}" BorderBrush="#FFB9C9F4" FontWeight="Bold"/>
                                                    <Button Grid.Column="1" x:Name="EmailRegisterModeButton" Content="ثبت‌نام" Click="EmailRegisterMode_Click" Height="40" Margin="4,0,0,0"
                                                            Background="{DynamicResource BlueVpnBg}" Foreground="{DynamicResource BlueVpnTextSecondary}" BorderBrush="{DynamicResource BlueVpnStroke}" FontWeight="Bold"/>
                                                </Grid>
                                                <TextBlock x:Name="EmailTitleText" Text="ورود با ایمیل" Foreground="{DynamicResource BlueVpnText}" FontSize="17" FontWeight="SemiBold"/>
                                                <TextBlock x:Name="EmailSubtitleText" Text="ایمیل و رمز عبور حساب BlueVPN خود را وارد کنید."
                                                           Foreground="{DynamicResource BlueVpnTextSecondary}" FontSize="12" TextWrapping="Wrap" LineHeight="19" Margin="0,8,0,15"/>
                                                <TextBlock Text="ایمیل" Foreground="{DynamicResource BlueVpnMuted}" FontSize="11.5" FontWeight="SemiBold"/>
                                                <TextBox x:Name="EmailBox" FlowDirection="LeftToRight" TextAlignment="Left"
                                                         Background="{DynamicResource BlueVpnSurface}" Foreground="{DynamicResource BlueVpnText}" BorderBrush="{DynamicResource BlueVpnStroke}" CaretBrush="{DynamicResource BlueVpnBlue}"
                                                         FontSize="13.5" Padding="12,9" Margin="0,7,0,11"/>
                                                <TextBlock Text="رمز عبور" Foreground="{DynamicResource BlueVpnMuted}" FontSize="11.5" FontWeight="SemiBold"/>
                                                <PasswordBox x:Name="PasswordBox" FlowDirection="LeftToRight"
                                                             Background="{DynamicResource BlueVpnSurface}" Foreground="{DynamicResource BlueVpnText}" BorderBrush="{DynamicResource BlueVpnStroke}" CaretBrush="{DynamicResource BlueVpnBlue}"
                                                             FontSize="13.5" Padding="12,9" Margin="0,7,0,9"/>
                                                <Button x:Name="EmailSubmitButton" Content="ورود به BlueVPN" Click="EmailSubmit_Click" Height="44" Margin="0,10,0,0"
                                                        Background="{DynamicResource BlueVpnBlue}" Foreground="White" BorderBrush="{DynamicResource BlueVpnBlue2}" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <TextBlock x:Name="AuthStatusText" Text="ورود روی همین دستگاه ذخیره می‌شود و اطلاعات اشتراک در پس‌زمینه همگام خواهد شد."
                                               Foreground="{DynamicResource BlueVpnMuted}" FontSize="11" TextAlignment="Center" TextWrapping="Wrap" LineHeight="18" Margin="8,14,8,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel x:Name="AccountPanel" Visibility="Collapsed">
                            <Border Background="{DynamicResource BlueVpnSurface}" CornerRadius="18" BorderBrush="{DynamicResource BlueVpnStroke}" BorderThickness="1" Padding="17">
                                <StackPanel>
                                    <TextBlock Text="وضعیت اشتراک" FontSize="11.5" Foreground="{DynamicResource BlueVpnMuted}" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="IdentityText" FontSize="18" FontWeight="Bold" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                    <Border Height="1" Background="{DynamicResource BlueVpnStroke}" Margin="0,13,0,11"/>
                                    <TextBlock x:Name="PlanText" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" LineHeight="20"/>
                                    <TextBlock x:Name="ExpiryText" Foreground="{DynamicResource BlueVpnTextSecondary}" FontSize="12" TextWrapping="Wrap" LineHeight="19" Margin="0,6,0,0"/>
                                    <TextBlock x:Name="TrafficText" Foreground="{DynamicResource BlueVpnTextSecondary}" FontSize="12" TextWrapping="Wrap" LineHeight="19" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="بروزرسانی حساب" Click="RefreshAccount_Click" Height="42" Margin="0,0,5,0"/>
                                <Button Grid.Column="1" Content="خروج" Click="Logout_Click" Height="42" Margin="5,0,0,0"/>
                            </Grid>
                        </StackPanel>

                        <StackPanel Margin="0,22,0,9">
                            <TextBlock Text="پلن‌های ویژه" FontSize="18" FontWeight="Bold"/>
                            <TextBlock Text="جزئیات هر پلن بدون فشرده‌سازی و با خوانایی کامل نمایش داده می‌شود." FontSize="11.5"
                                       Foreground="{DynamicResource BlueVpnTextSecondary}" TextWrapping="Wrap" LineHeight="18" Margin="0,5,0,0"/>
                        </StackPanel>
                        <ItemsControl x:Name="PlansList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource BlueVpnSurface}" CornerRadius="16" BorderBrush="{DynamicResource BlueVpnStroke}" BorderThickness="1" Padding="15" Margin="0,5">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="Bold" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Description}" FontSize="11.5" Foreground="{DynamicResource BlueVpnTextSecondary}"
                                                       TextWrapping="Wrap" LineHeight="18" Margin="0,5,0,10"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="مدت" FontSize="10.5" Foreground="{DynamicResource BlueVpnMuted}"/>
                                                    <TextBlock FontSize="12.5" FontWeight="SemiBold" Margin="0,2,0,0"><Run Text="{Binding DurationDays}"/><Run Text=" روز"/></TextBlock>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                                    <TextBlock Text="قیمت" FontSize="10.5" Foreground="{DynamicResource BlueVpnMuted}" TextAlignment="Right"/>
                                                    <TextBlock FontSize="14" FontWeight="Bold" Foreground="{DynamicResource BlueVpnBlue2}" Margin="0,2,0,0" TextAlignment="Right"><Run Text="{Binding PriceToman}"/><Run Text=" تومان"/></TextBlock>
                                                </StackPanel>
                                            </Grid>
                                            <TextBlock FontSize="10.5" Foreground="{DynamicResource BlueVpnMuted}" TextWrapping="Wrap" Margin="0,9,0,0">
                                                <Run Text="حجم: "/><Run Text="{Binding DataLimitGb}"/><Run Text=" GB   •   دستگاه: "/><Run Text="{Binding DeviceLimit}"/>
                                            </TextBlock>
                                            <Button Content="خرید و پرداخت امن" Click="PurchasePlan_Click" Tag="{Binding}" Height="42" Margin="0,12,0,0"
                                                    Background="{DynamicResource BlueVpnBlue}" Foreground="White" BorderBrush="{DynamicResource BlueVpnBlue2}" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="PurchaseStatusText" Text="برای خرید، وارد حساب شوید و پلن موردنظر را انتخاب کنید."
                                   FontSize="11.5" Foreground="{DynamicResource BlueVpnTextSecondary}" TextWrapping="Wrap" LineHeight="18" Margin="3,10,3,2"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Support drawer: first-party authenticated ticket/chat UI. -->
        <Grid x:Name="SupportDrawer" Visibility="Collapsed" Background="{DynamicResource BlueVpnOverlay}" Panel.ZIndex="22">
            <Border Width="460" MaxWidth="460" HorizontalAlignment="Right" VerticalAlignment="Stretch" Background="{DynamicResource BlueVpnBg}"
                    Padding="20" BorderBrush="{DynamicResource BlueVpnStroke}" BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="پشتیبانی BlueVPN" FontSize="22" FontWeight="Bold"/>
                            <TextBlock Text="گفتگوی مستقیم با تیم پشتیبانی" FontSize="11.5" Foreground="{DynamicResource BlueVpnTextSecondary}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="✕" Click="CloseDrawers_Click" Width="42" Height="42" Padding="0"/>
                    </Grid>

                    <Border Grid.Row="1" Background="{DynamicResource BlueVpnSurface}" CornerRadius="16" BorderBrush="{DynamicResource BlueVpnStroke}" BorderThickness="1" Padding="13" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="گفتگوی جدید" FontWeight="Bold" FontSize="14"/>
                            <ComboBox x:Name="SupportDepartmentBox" DisplayMemberPath="Name" Margin="0,9,0,6" MinHeight="38"/>
                            <TextBox x:Name="SupportSubjectBox" MinHeight="38" Margin="0,2,0,6" ToolTip="موضوع"/>
                            <TextBox x:Name="SupportNewMessageBox" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MinHeight="72" MaxHeight="120" Margin="0,2,0,7" ToolTip="شرح درخواست"/>
                            <Button Content="ایجاد درخواست پشتیبانی" Click="CreateSupport_Click" Height="40" Margin="0"
                                    Background="{DynamicResource BlueVpnBlue}" Foreground="White" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="2" Margin="0,0,0,9">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <ComboBox x:Name="SupportConversationBox" DisplayMemberPath="DisplayTitle" SelectionChanged="SupportConversation_SelectionChanged" MinHeight="38"/>
                        <Button Grid.Column="1" Content="↻" Click="RefreshSupport_Click" Width="44" Height="38" Padding="0" Margin="7,0,0,0" ToolTip="بروزرسانی"/>
                    </Grid>

                    <Border Grid.Row="3" Background="{DynamicResource BlueVpnSurface}" CornerRadius="16" BorderBrush="{DynamicResource BlueVpnStroke}" BorderThickness="1" Padding="10">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="SupportMessagesList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource BlueVpnSurfaceStrong}" CornerRadius="12" Padding="10" Margin="0,4">
                                            <StackPanel>
                                                <TextBlock Text="{Binding SenderLabel}" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource BlueVpnBlue2}"/>
                                                <TextBlock Text="{Binding Body}" FontSize="12.5" TextWrapping="Wrap" LineHeight="19" Margin="0,4,0,0"/>
                                                <TextBlock Text="{Binding CreatedAt}" FontSize="9.5" Foreground="{DynamicResource BlueVpnMuted}" Margin="0,5,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <StackPanel Grid.Row="4" Margin="0,10,0,0">
                        <TextBlock x:Name="SupportStatusText" Text="آماده" FontSize="11" Foreground="{DynamicResource BlueVpnTextSecondary}" TextWrapping="Wrap" Margin="2,0,2,5"/>
                        <TextBox x:Name="SupportReplyBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="54" MaxHeight="100" ToolTip="پیام شما"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="ارسال پیام" Click="SendSupport_Click" Height="40" Margin="0,4,4,0"
                                    Background="{DynamicResource BlueVpnBlue}" Foreground="White" FontWeight="SemiBold"/>
                            <Button Grid.Column="1" Content="بستن گفتگو" Click="CloseSupportConversation_Click" Height="40" Margin="4,4,0,0"/>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Settings/menu drawer -->
        <!-- 5.2.2: readable diagnostics/update layout at high DPI. -->
        <Grid x:Name="MenuDrawer" Visibility="Collapsed" Background="{DynamicResource BlueVpnOverlay}" Panel.ZIndex="21">
            <Border Width="420" MaxWidth="420" HorizontalAlignment="Right" VerticalAlignment="Stretch" Background="{DynamicResource BlueVpnBg}"
                    Padding="22" BorderBrush="{DynamicResource BlueVpnStroke}" BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                    <StackPanel Margin="6,0,0,0">
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="BlueVPN" FontSize="25" FontStyle="Italic" FontWeight="Bold" Foreground="{DynamicResource BlueVpnBlue}"/>
                                <TextBlock Text="تنظیمات، بروزرسانی و وضعیت فنی" FontSize="11.5" Foreground="{DynamicResource BlueVpnTextSecondary}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="✕" Click="CloseDrawers_Click" Width="42" Height="42" Padding="0" Margin="8,0,0,0"/>
                        </Grid>

                        <Border Background="{DynamicResource BlueVpnSurface}" CornerRadius="18" BorderBrush="{DynamicResource BlueVpnStroke}" BorderThickness="1" Padding="16">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="1"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="نسخه برنامه" FontSize="11.5" Foreground="{DynamicResource BlueVpnMuted}"/>
                                <TextBlock Grid.Row="1" x:Name="MenuVersionText" Text="6.0.10" FontSize="18" FontWeight="Bold" Margin="0,4,0,12"/>
                                <Border Grid.Row="2" Background="{DynamicResource BlueVpnStroke}" Margin="0,0,0,11"/>
                                <TextBlock Grid.Row="3" Text="هسته اتصال" FontSize="11.5" Foreground="{DynamicResource BlueVpnMuted}"/>
                                <TextBlock Grid.Row="4" x:Name="CoreVersionText" Text="BlueVPN Core" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </Grid>
                        </Border>

                        <Button x:Name="UpdateButton" Content="بررسی بروزرسانی" Click="Update_Click" Height="46" Margin="0,14,0,0"
                                Background="{DynamicResource BlueVpnBlue}" Foreground="White" FontWeight="SemiBold"/>
                        <ProgressBar x:Name="UpdateProgressBar" Height="9" Minimum="0" Maximum="100" Value="0" Visibility="Collapsed" Margin="3,10,3,0"/>
                        <TextBlock x:Name="UpdateStatusText" Text="" FontSize="12" Foreground="{DynamicResource BlueVpnTextSecondary}"
                                   TextWrapping="Wrap" TextAlignment="Right" LineHeight="19" Margin="3,8,3,0"/>

                        <Border Background="{DynamicResource BlueVpnSurface}" CornerRadius="18" BorderBrush="{DynamicResource BlueVpnStroke}" BorderThickness="1" Padding="16" Margin="0,15,0,0">
                            <StackPanel>
                                <TextBlock Text="وضعیت فنی" FontSize="15" FontWeight="Bold"/>
                                <TextBlock Text="Core / BlueAI / مسیر فعال" FontSize="10.5" Foreground="{DynamicResource BlueVpnMuted}" Margin="0,3,0,0"/>
                                <TextBlock x:Name="MenuTechnicalText" Text="در حال بررسی هسته اتصال…" Foreground="{DynamicResource BlueVpnTextSecondary}"
                                           FontSize="12.5" TextWrapping="Wrap" TextAlignment="Right" LineHeight="20" Margin="0,11,0,0" MinHeight="40"/>
                                <Border Height="1" Background="{DynamicResource BlueVpnStroke}" Margin="0,12,0,10"/>
                                <TextBlock x:Name="MenuIpText" Text="IP: —" Foreground="{DynamicResource BlueVpnTextSecondary}" FontSize="12.5"
                                           TextWrapping="Wrap" FlowDirection="LeftToRight" TextAlignment="Left"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource BlueVpnSurface}" CornerRadius="18" BorderBrush="{DynamicResource BlueVpnStroke}" BorderThickness="1" Padding="16" Margin="0,15,0,0">
                            <StackPanel>
                                <TextBlock Text="ظاهر برنامه" FontSize="15" FontWeight="Bold"/>
                                <TextBlock Text="تم انتخابی روی همین دستگاه ذخیره می‌شود." FontSize="10.5" Foreground="{DynamicResource BlueVpnMuted}" Margin="0,3,0,8"/>
                                <ComboBox x:Name="ThemeComboBox" SelectionChanged="ThemeComboBox_SelectionChanged" MinHeight="40">
                                    <ComboBoxItem Tag="system" Content="مطابق Windows"/>
                                    <ComboBoxItem Tag="light" Content="روشن"/>
                                    <ComboBoxItem Tag="dark" Content="تیره"/>
                                </ComboBox>
                            </StackPanel>
                        </Border>

                        <Grid Margin="0,13,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="حساب و خرید سرویس" Click="OpenAccountFromMenu_Click" Height="44" Margin="0,0,5,0"/>
                            <Button Grid.Column="1" x:Name="SupportMenuButton" Content="پشتیبانی" Click="OpenSupport_Click" Height="44" Margin="5,0,0,0"
                                    Background="{DynamicResource BlueVpnBlue}" Foreground="White" FontWeight="SemiBold"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
