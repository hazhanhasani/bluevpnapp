<Window x:Class="BlueVPN.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BlueVPN" Height="930" Width="600" MinHeight="720" MinWidth="460"
        WindowStartupLocation="CenterScreen" FlowDirection="RightToLeft"
        Background="{StaticResource BlueVpnBg}">
    <Grid>
        <Grid.Background>
            <RadialGradientBrush Center="0.55,0.28" GradientOrigin="0.55,0.28" RadiusX="0.9" RadiusY="0.8">
                <GradientStop Color="#FFEAF0FF" Offset="0"/>
                <GradientStop Color="#FFF6F8FC" Offset="0.55"/>
                <GradientStop Color="#FFF6F8FC" Offset="1"/>
            </RadialGradientBrush>
        </Grid.Background>

        <!-- Main home: intentionally mirrors BlueVpnHomeActivity Android ordering. -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid MaxWidth="560" Margin="18,12,18,22">
                <StackPanel>
                    <!-- Android header: menu | version | account -->
                    <Grid Height="60">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="72"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="72"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" x:Name="AccountButton" Click="AccountButton_Click"
                                FontSize="30" Content="♙" Width="56" Height="56" Padding="0"
                                Background="White" BorderBrush="{StaticResource BlueVpnStroke}"/>
                        <TextBlock Grid.Column="1" x:Name="VersionText" Text="4.17.6" FontSize="12"
                                   FontWeight="SemiBold" Foreground="{StaticResource BlueVpnMuted}"
                                   VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <Button Grid.Column="2" x:Name="MenuButton" Click="MenuButton_Click"
                                FontSize="29" Content="☰" Width="56" Height="56" Padding="0"
                                Background="White" BorderBrush="{StaticResource BlueVpnStroke}"/>
                    </Grid>

                    <!-- Brand block -->
                    <StackPanel Margin="0,12,0,0">
                        <TextBlock Text="BlueVPN" FontSize="42" FontStyle="Italic" FontWeight="Bold"
                                   Foreground="{StaticResource BlueVpnBlue}" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="SubscriptionSummaryText" Text="در حال آماده‌سازی حساب"
                                   FontSize="13" Foreground="{StaticResource BlueVpnMuted}"
                                   HorizontalAlignment="Center" Margin="0,8,0,0" TextAlignment="Center"/>
                    </StackPanel>

                    <!-- Status + Android slider-like connect control -->
                    <StackPanel Margin="0,28,0,0">
                        <Grid Height="58">
                            <TextBlock x:Name="StatusText" Text="آماده اتصال" FontSize="25" FontWeight="SemiBold"
                                       VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="{StaticResource BlueVpnMuted}"
                                     VerticalAlignment="Top" HorizontalAlignment="Left" Margin="56,8,0,0"/>
                        </Grid>
                        <TextBlock x:Name="ConnectionStatusText" Text="بهترین اتصال به‌صورت خودکار انتخاب می‌شود"
                                   FontSize="13" Foreground="{StaticResource BlueVpnTextSecondary}"
                                   TextAlignment="Center" HorizontalAlignment="Center" Margin="12,0,12,14"/>

                        <Grid Height="132" Margin="30,0">
                            <Border x:Name="OrbHalo" Height="112" CornerRadius="56" VerticalAlignment="Center"
                                    BorderBrush="{StaticResource BlueVpnBlue}" BorderThickness="1.2"
                                    Background="#DDE8F8FF" Effect="{x:Null}"/>
                            <Grid Margin="9,10">
                                <TextBlock x:Name="OrbText" Text="برای اتصال لمس کنید" FontSize="17"
                                           FontWeight="SemiBold" Foreground="{StaticResource BlueVpnTextSecondary}"
                                           VerticalAlignment="Center" HorizontalAlignment="Center" Margin="88,0,12,0"/>
                                <Border x:Name="StatusOrb" Width="92" Height="92" CornerRadius="46"
                                        Background="{StaticResource BlueVpnBlue}" BorderBrush="{StaticResource BlueVpnBlue2}"
                                        BorderThickness="1.5" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <Button x:Name="ConnectButton" Content="⏻" Click="Connect_Click" FontSize="55"
                                            Foreground="White" Background="Transparent" BorderThickness="0" Padding="0" Margin="0"/>
                                </Border>
                            </Grid>
                        </Grid>
                    </StackPanel>

                    <!-- Same three telemetry cards as Android -->
                    <UniformGrid Columns="3" Height="82" Margin="3,4,3,0">
                        <Border Background="White" CornerRadius="20" BorderBrush="{StaticResource BlueVpnStroke}" BorderThickness="1" Margin="4" Padding="8">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="↑  آپلود" FontSize="11" Foreground="{StaticResource BlueVpnMuted}"/>
                                <TextBlock x:Name="UploadSpeedValue" Text="0 KB/s" FontSize="16" FontWeight="Bold" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Background="White" CornerRadius="20" BorderBrush="{StaticResource BlueVpnStroke}" BorderThickness="1" Margin="4" Padding="8">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="◷  مدت اتصال" FontSize="11" Foreground="{StaticResource BlueVpnMuted}"/>
                                <TextBlock x:Name="DurationValue" Text="00:00:00" FontSize="16" FontWeight="Bold" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Background="White" CornerRadius="20" BorderBrush="{StaticResource BlueVpnStroke}" BorderThickness="1" Margin="4" Padding="8">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="↓  دانلود" FontSize="11" Foreground="{StaticResource BlueVpnMuted}"/>
                                <TextBlock x:Name="DownloadSpeedValue" Text="0 KB/s" FontSize="16" FontWeight="Bold" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                    <TextBlock x:Name="SpeedValue" Text="0 KB/s" Visibility="Collapsed"/>

                    <!-- Campaign banner is in the exact Android position: below live telemetry, above server card. -->
                    <Border x:Name="AdCard" Background="White" CornerRadius="22" Margin="4,12,4,0"
                            Visibility="Collapsed" MouseLeftButtonUp="AdCard_Click" Cursor="Hand" ClipToBounds="True"
                            BorderBrush="{StaticResource BlueVpnStroke}" BorderThickness="1">
                        <Grid Height="170">
                            <Image x:Name="AdImage" Stretch="UniformToFill"/>
                            <Border Background="#7A10141D" VerticalAlignment="Bottom" Padding="14,10" Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock x:Name="AdTitle" FontSize="15" FontWeight="Bold" Foreground="White"/>
                                    <TextBlock x:Name="AdSubtitle" FontSize="10" Foreground="White" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="AdActionText" Text="مشاهده" Visibility="Collapsed"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Android server/location card -->
                    <Border Background="White" CornerRadius="24" BorderBrush="{StaticResource BlueVpnStroke}" BorderThickness="1"
                            Padding="18,16" Margin="4,14,4,0" MinHeight="112">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="44"/>
                            </Grid.ColumnDefinitions>
                            <Ellipse Grid.Column="0" Width="12" Height="12" Fill="{StaticResource BlueVpnBlue}" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0">
                                <TextBlock x:Name="EndpointText" Text="انتخاب خودکار" FontSize="18" FontWeight="Bold"/>
                                <TextBlock x:Name="EngineText" Text="بهترین مسیر همان لوکیشن به‌صورت خودکار انتخاب می‌شود"
                                           FontSize="11" Foreground="{StaticResource BlueVpnMuted}" Margin="0,5,0,0"/>
                                <TextBlock x:Name="ServerStatusText" Text="آماده اتصال" FontSize="10" Foreground="{StaticResource BlueVpnMuted}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="☰" FontSize="27" Foreground="{StaticResource BlueVpnMuted}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Remaining entitlement card from Android -->
                    <Border Background="White" CornerRadius="20" BorderBrush="{StaticResource BlueVpnStroke}" BorderThickness="1"
                            Margin="4,12,4,0" Padding="8" Height="72">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="1"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="حجم باقی‌مانده" FontSize="10" Foreground="{StaticResource BlueVpnMuted}"/>
                                <TextBlock x:Name="RemainingVolumeValue" Text="—" FontSize="14" FontWeight="Bold" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Border Grid.Column="1" Background="{StaticResource BlueVpnStroke}" Height="34" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="زمان باقی‌مانده" FontSize="10" Foreground="{StaticResource BlueVpnMuted}"/>
                                <TextBlock x:Name="RemainingTimeValue" Text="—" FontSize="14" FontWeight="Bold" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Internal-only fields retained for diagnostics, not shown in the Android-style home. -->
                    <StackPanel Visibility="Collapsed">
                        <TextBlock x:Name="TierText" Text="Free"/>
                        <TextBlock x:Name="IpValue" Text="—"/>
                        <TextBlock x:Name="PingValue" Text="—"/>
                        <TextBlock x:Name="LocationBadge" Text="AUTO"/>
                        <TextBlock x:Name="TechnicalText" Text=""/>
                        <TextBlock x:Name="RuntimeBadge" Text="v2rayN"/>
                        <TextBlock x:Name="FooterStatus" Text="آماده"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Account drawer: replaces the old permanent desktop sidebar. -->
        <Grid x:Name="AccountDrawer" Visibility="Collapsed" Background="#66000000" Panel.ZIndex="20">
            <Border Width="380" HorizontalAlignment="Left" VerticalAlignment="Stretch" Background="{StaticResource BlueVpnBg}"
                    Padding="20" BorderBrush="{StaticResource BlueVpnStroke}" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="حساب BlueVPN" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="✕" Click="CloseDrawers_Click" Width="42" Height="42" Padding="0"/>
                        </Grid>
                        <StackPanel x:Name="LoginPanel">
                            <TextBlock Text="ایمیل" Foreground="{StaticResource BlueVpnMuted}"/><TextBox x:Name="EmailBox" FlowDirection="LeftToRight" TextAlignment="Left"/>
                            <TextBlock Text="رمز عبور" Foreground="{StaticResource BlueVpnMuted}"/><PasswordBox x:Name="PasswordBox" FlowDirection="LeftToRight"/>
                            <UniformGrid Columns="2"><Button Content="ورود" Click="Login_Click"/><Button Content="ثبت‌نام" Click="Register_Click"/></UniformGrid>
                            <Separator Margin="0,14" Background="{StaticResource BlueVpnStroke}"/>
                            <TextBlock Text="ورود با پیامک" FontWeight="SemiBold"/>
                            <TextBox x:Name="PhoneBox" FlowDirection="LeftToRight" TextAlignment="Left"/>
                            <Button Content="ارسال کد" Click="RequestOtp_Click"/>
                            <TextBox x:Name="OtpBox" FlowDirection="LeftToRight" TextAlignment="Left"/>
                            <Button Content="تأیید و ورود" Click="VerifyOtp_Click" Background="{StaticResource BlueVpnBlue}" Foreground="White"/>
                        </StackPanel>
                        <StackPanel x:Name="AccountPanel" Visibility="Collapsed">
                            <Border Background="White" CornerRadius="18" BorderBrush="{StaticResource BlueVpnStroke}" BorderThickness="1" Padding="14">
                                <StackPanel>
                                    <TextBlock x:Name="IdentityText" FontSize="17" FontWeight="Bold"/>
                                    <TextBlock x:Name="PlanText" Margin="0,7,0,0"/>
                                    <TextBlock x:Name="ExpiryText" Foreground="{StaticResource BlueVpnMuted}" Margin="0,4,0,0"/>
                                    <TextBlock x:Name="TrafficText" Foreground="{StaticResource BlueVpnMuted}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                            <UniformGrid Columns="2" Margin="0,8,0,0"><Button Content="بروزرسانی حساب" Click="RefreshAccount_Click"/><Button Content="خروج" Click="Logout_Click"/></UniformGrid>
                        </StackPanel>
                        <TextBlock Text="پلن‌ها" FontSize="16" FontWeight="Bold" Margin="0,18,0,8"/>
                        <ItemsControl x:Name="PlansList"><ItemsControl.ItemTemplate><DataTemplate>
                            <Border Background="White" CornerRadius="14" BorderBrush="{StaticResource BlueVpnStroke}" BorderThickness="1" Padding="11" Margin="0,4">
                                <StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock FontSize="11" Foreground="{StaticResource BlueVpnMuted}"><Run Text="{Binding DurationDays}"/><Run Text=" روز • "/><Run Text="{Binding PriceToman}"/><Run Text=" تومان"/></TextBlock></StackPanel>
                            </Border>
                        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Settings/menu drawer -->
        <Grid x:Name="MenuDrawer" Visibility="Collapsed" Background="#66000000" Panel.ZIndex="21">
            <Border Width="360" HorizontalAlignment="Right" VerticalAlignment="Stretch" Background="{StaticResource BlueVpnBg}"
                    Padding="20" BorderBrush="{StaticResource BlueVpnStroke}" BorderThickness="1,0,0,0">
                <StackPanel>
                    <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="BlueVPN" FontSize="24" FontStyle="Italic" FontWeight="Bold" Foreground="{StaticResource BlueVpnBlue}"/>
                        <Button Grid.Column="1" Content="✕" Click="CloseDrawers_Click" Width="42" Height="42" Padding="0"/>
                    </Grid>
                    <Border Background="White" CornerRadius="18" BorderBrush="{StaticResource BlueVpnStroke}" BorderThickness="1" Padding="14">
                        <StackPanel>
                            <TextBlock Text="نسخه برنامه" FontSize="11" Foreground="{StaticResource BlueVpnMuted}"/>
                            <TextBlock x:Name="MenuVersionText" Text="4.17.6" FontSize="17" FontWeight="Bold" Margin="0,3,0,10"/>
                            <TextBlock Text="هسته اتصال" FontSize="11" Foreground="{StaticResource BlueVpnMuted}"/>
                            <TextBlock x:Name="CoreVersionText" Text="v2rayN" FontSize="15" FontWeight="SemiBold" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>
                    <Button x:Name="UpdateButton" Content="بررسی بروزرسانی" Click="Update_Click" Margin="0,12,0,0" Background="{StaticResource BlueVpnBlue}" Foreground="White"/>
                    <Border Background="White" CornerRadius="18" BorderBrush="{StaticResource BlueVpnStroke}" BorderThickness="1" Padding="14" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="وضعیت فنی" FontWeight="Bold"/>
                            <TextBlock x:Name="MenuTechnicalText" Text="در حال بررسی هسته اتصال…" Foreground="{StaticResource BlueVpnMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/>
                            <TextBlock x:Name="MenuIpText" Text="IP: —" Foreground="{StaticResource BlueVpnMuted}" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
