<Window x:Class="BlueVPN.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BlueVPN" Height="760" Width="620" MinHeight="600" MinWidth="460"
        WindowStartupLocation="CenterScreen" FlowDirection="RightToLeft"
        Background="{StaticResource BlueVpnBg}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
    <Grid>
        <Grid.Background>
            <RadialGradientBrush Center="0.52,0.26" GradientOrigin="0.52,0.26" RadiusX="0.92" RadiusY="0.82">
                <GradientStop Color="#FFEAF1FF" Offset="0"/>
                <GradientStop Color="#FFF5F7FC" Offset="0.58"/>
                <GradientStop Color="#FFF6F8FC" Offset="1"/>
            </RadialGradientBrush>
        </Grid.Background>

        <!-- Android BlueVpnHomeActivity parity: header → brand → status/orb → metrics → ad → server → entitlement. -->
        <ScrollViewer x:Name="HomeScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
        <Grid MaxWidth="680" Margin="18,8,18,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="62"/>
                <RowDefinition Height="188"/>
                <RowDefinition Height="58"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="78"/>
                <RowDefinition Height="56"/>
            </Grid.RowDefinitions>

            <!-- Header: account left, version centered, menu right exactly like Android. -->
            <Grid Grid.Row="0" FlowDirection="LeftToRight">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="82"/>
                    <ColumnDefinition Width="60"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" x:Name="AccountButton" Click="AccountButton_Click"
                        Width="48" Height="48" Padding="0" Margin="0" ToolTip="حساب BlueVPN"
                        Background="White" BorderBrush="{StaticResource BlueVpnStroke}">
                    <Grid Width="24" Height="24">
                        <Ellipse Width="8" Height="8" Stroke="{StaticResource BlueVpnTextSecondary}" StrokeThickness="1.8" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,2,0,0"/>
                        <Path Data="M4,21 C4.6,15 8,12.5 12,12.5 C16,12.5 19.4,15 20,21 Z" Stroke="{StaticResource BlueVpnTextSecondary}" StrokeThickness="1.8" Fill="Transparent" StrokeLineJoin="Round"/>
                    </Grid>
                </Button>
                <TextBlock Grid.Column="2" x:Name="VersionText" Text="5.0.7" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource BlueVpnMuted}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                <Button Grid.Column="3" x:Name="MenuButton" Click="MenuButton_Click"
                        Width="48" Height="48" Padding="0" Margin="0" ToolTip="منو"
                        Background="White" BorderBrush="{StaticResource BlueVpnStroke}">
                    <Grid Width="24" Height="20">
                        <Line X1="2" Y1="4" X2="22" Y2="4" Stroke="{StaticResource BlueVpnTextSecondary}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        <Line X1="2" Y1="10" X2="22" Y2="10" Stroke="{StaticResource BlueVpnTextSecondary}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        <Line X1="2" Y1="16" X2="22" Y2="16" Stroke="{StaticResource BlueVpnTextSecondary}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Grid>
                </Button>
            </Grid>

            <!-- Brand block -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                <TextBlock Text="BlueVPN" FontSize="38" FontStyle="Italic" FontWeight="Bold"
                           Foreground="{StaticResource BlueVpnBlue}" HorizontalAlignment="Center"/>
                <TextBlock x:Name="SubscriptionSummaryText" Text="در حال آماده‌سازی حساب" FontSize="12.5"
                           Foreground="{StaticResource BlueVpnMuted}" HorizontalAlignment="Center"
                           Margin="0,5,0,0" TextAlignment="Center"/>
            </StackPanel>

            <!-- Flexible orb stage, mirroring Android createOrbStage(). -->
            <Grid Grid.Row="2" Margin="0,2,0,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="54"/>
                    <RowDefinition Height="32"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" FlowDirection="RightToLeft">
                    <Ellipse x:Name="StatusDot" Width="11" Height="11" Fill="{StaticResource BlueVpnMuted}" Margin="0,0,10,0"/>
                    <TextBlock x:Name="StatusText" Text="آماده اتصال" FontSize="25" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Grid.Row="1" x:Name="ConnectionStatusText" Text="بهترین اتصال به‌صورت خودکار انتخاب می‌شود"
                           FontSize="12" Foreground="{StaticResource BlueVpnTextSecondary}" TextAlignment="Center"
                           HorizontalAlignment="Center" VerticalAlignment="Top"/>

                <Grid Grid.Row="2" Width="330" Height="126" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Border x:Name="OrbHalo" Height="118" CornerRadius="59" VerticalAlignment="Center"
                            BorderBrush="{StaticResource BlueVpnBlue}" BorderThickness="1.2" Background="#DDE8F8FF"/>
                    <Border Height="108" CornerRadius="54" Margin="7,5" BorderBrush="#60356DF1" BorderThickness="1" Background="#F7FFFFFF"/>
                    <!-- Android screenshot: hint on left, power orb on right. -->
                    <Grid Margin="9" FlowDirection="LeftToRight">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="96"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" x:Name="OrbText" Text="برای اتصال لمس کنید" FontSize="16"
                                   FontWeight="SemiBold" Foreground="{StaticResource BlueVpnTextSecondary}"
                                   VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <Border Grid.Column="1" x:Name="StatusOrb" Width="90" Height="90" CornerRadius="45"
                                Background="{StaticResource BlueVpnBlue}" BorderBrush="{StaticResource BlueVpnBlue2}"
                                BorderThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button x:Name="ConnectButton" Click="Connect_Click" Foreground="White" Background="Transparent" BorderThickness="0" Padding="0" Margin="0" ToolTip="اتصال / قطع اتصال">
                                <Grid Width="46" Height="46">
                                    <Path x:Name="PowerArc" Stroke="White" StrokeThickness="4.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Data="M 12,10 A 15,15 0 1 0 34,10" Stretch="Uniform" Margin="4,8,4,3"/>
                                    <Line x:Name="PowerStem" X1="23" Y1="3" X2="23" Y2="21" Stroke="White" StrokeThickness="4.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Grid>
                            </Button>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>

            <!-- Live telemetry: download | duration | upload, same visual order as Android screenshot. -->
            <UniformGrid Grid.Row="3" Columns="3" FlowDirection="LeftToRight" Margin="0,0,0,6">
                <Border Style="{StaticResource BlueVpnMetricCardStyle}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" FlowDirection="RightToLeft">
                        <TextBlock Text="↓  دانلود" FontSize="10.5" Foreground="{StaticResource BlueVpnMuted}"/>
                        <TextBlock x:Name="DownloadSpeedValue" Text="0 KB/s" FontSize="15" FontWeight="Bold" Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource BlueVpnMetricCardStyle}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="◷  مدت اتصال" FontSize="10.5" Foreground="{StaticResource BlueVpnMuted}"/>
                        <TextBlock x:Name="DurationValue" Text="00:00:00" FontSize="15" FontWeight="Bold" Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource BlueVpnMetricCardStyle}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" FlowDirection="RightToLeft">
                        <TextBlock Text="↑  آپلود" FontSize="10.5" Foreground="{StaticResource BlueVpnMuted}"/>
                        <TextBlock x:Name="UploadSpeedValue" Text="0 KB/s" FontSize="15" FontWeight="Bold" Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>
            <TextBlock x:Name="SpeedValue" Text="0 KB/s" Visibility="Collapsed"/>

            <!-- Android-position campaign banner. Network images are loaded off the dispatcher. -->
            <Border Grid.Row="4" x:Name="AdCard" Height="88" MaxHeight="96" Background="#FF071328" CornerRadius="20"
                    Margin="4,2,4,9" Visibility="Collapsed" MouseLeftButtonUp="AdCard_Click" Cursor="Hand"
                    ClipToBounds="True" BorderBrush="{StaticResource BlueVpnStroke}" BorderThickness="1">
                <Grid>
                    <Border x:Name="AdFallbackPanel" Background="#FF071328">
                        <Grid Margin="18,14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="86"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock x:Name="AdTitle" Text="BlueVPN" Foreground="White" FontSize="16" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="AdSubtitle" Text="پیشنهاد ویژه BlueVPN" Foreground="#FFD5E3FF" FontSize="10.5" Margin="0,6,0,0"
                                           TextWrapping="Wrap" MaxHeight="34"/>
                            </StackPanel>
                            <Border Grid.Column="1" Background="#26356DF1" BorderBrush="#80356DF1" BorderThickness="1" CornerRadius="14" Padding="9,7" VerticalAlignment="Center">
                                <TextBlock x:Name="AdActionText" Text="مشاهده ←" Foreground="White" FontSize="10.5" FontWeight="Bold" TextAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>
                    <Image x:Name="AdImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <Border Background="#36000000" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="10" CornerRadius="12" Padding="8,4">
                        <TextBlock Text="تبلیغ" Foreground="White" FontSize="9"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Server/location card -->
            <Border Grid.Row="5" x:Name="LocationCard" Background="White" CornerRadius="24" BorderBrush="{StaticResource BlueVpnStroke}"
                    BorderThickness="1" Padding="14,7" Margin="4,0,4,7" Cursor="Hand"
                    MouseLeftButtonUp="LocationCard_Click" ToolTip="انتخاب لوکیشن">
                <Grid FlowDirection="LeftToRight">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/><ColumnDefinition Width="22"/></Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="≡" FontSize="25" FontWeight="Bold" Foreground="{StaticResource BlueVpnBlue}"
                               VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    <StackPanel Grid.Column="1" FlowDirection="RightToLeft" VerticalAlignment="Center" Margin="8,0">
                        <TextBlock x:Name="EndpointText" Text="انتخاب خودکار" FontSize="16" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="EngineText" Text="بهترین مسیر همان لوکیشن به‌صورت خودکار انتخاب می‌شود"
                                   FontSize="11.5" Foreground="{StaticResource BlueVpnTextSecondary}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="ServerStatusText" Text="آماده اتصال" FontSize="10.5"
                                   Foreground="{StaticResource BlueVpnTextSecondary}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Ellipse Grid.Column="2" Width="12" Height="12" Fill="{StaticResource BlueVpnBlue}" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Remaining entitlement row -->
            <Border Grid.Row="6" Background="White" CornerRadius="20" BorderBrush="{StaticResource BlueVpnStroke}"
                    BorderThickness="1" Margin="4,0,4,0" Padding="8">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="1"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="حجم باقی‌مانده" FontSize="10" Foreground="{StaticResource BlueVpnMuted}"/>
                        <TextBlock x:Name="RemainingVolumeValue" Text="—" FontSize="14" FontWeight="Bold" Margin="0,3,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="{StaticResource BlueVpnStroke}" Height="32" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="زمان باقی‌مانده" FontSize="10" Foreground="{StaticResource BlueVpnMuted}"/>
                        <TextBlock x:Name="RemainingTimeValue" Text="—" FontSize="14" FontWeight="Bold" Margin="0,3,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Internal fields retained for diagnostics/menu only. -->
            <StackPanel Visibility="Collapsed">
                <TextBlock x:Name="TierText" Text="Free"/><TextBlock x:Name="IpValue" Text="—"/>
                <TextBlock x:Name="PingValue" Text="—"/><TextBlock x:Name="LocationBadge" Text="AUTO"/>
                <TextBlock x:Name="TechnicalText"/><TextBlock x:Name="RuntimeBadge" Text="BlueVPN Core"/>
                <TextBlock x:Name="FooterStatus" Text="آماده"/>
            </StackPanel>
        </Grid>
        </ScrollViewer>

        <!-- Connecting overlay mirrors Android: full home takeover, explicit cancel, no frozen UI. -->
        <Grid x:Name="ConnectingOverlay" Visibility="Collapsed" Background="#F8F6F8FC" Panel.ZIndex="15">
            <Grid MaxWidth="460" Margin="22,18">
                <Grid.RowDefinitions><RowDefinition Height="54"/><RowDefinition Height="*"/><RowDefinition Height="72"/></Grid.RowDefinitions>
                <Grid Grid.Row="0" FlowDirection="LeftToRight">
                    <Button Content="لغو" Click="CancelConnection_Click" Width="82" Height="42" HorizontalAlignment="Left"/>
                    <TextBlock Text="BlueVPN" Foreground="{StaticResource BlueVpnBlue}" FontWeight="Bold" FontSize="15"
                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
                <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Width="360">
                    <Ellipse Width="190" Height="190" Stroke="#50356DF1" StrokeThickness="18" Fill="#16356DF1"/>
                    <TextBlock Text="در حال اتصال" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,18,0,0"/>
                    <TextBlock x:Name="ConnectingStageText" Text="در حال انتخاب بهترین اتصال" FontSize="12.5"
                               Foreground="{StaticResource BlueVpnMuted}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0"/>
                </StackPanel>
                <Border Grid.Row="2" Background="White" CornerRadius="18" BorderBrush="{StaticResource BlueVpnStroke}" BorderThickness="1" Padding="12">
                    <TextBlock Text="BlueVPN فقط پس از تأیید TUN، مسیر سیستم و تغییر IP وضعیت «متصل» را نمایش می‌دهد."
                               FontSize="10.5" Foreground="{StaticResource BlueVpnTextSecondary}" TextAlignment="Center" TextWrapping="Wrap"/>
                </Border>
            </Grid>
        </Grid>

        <!-- Account drawer -->
        <Grid x:Name="AccountDrawer" Visibility="Collapsed" Background="#66000000" Panel.ZIndex="20">
            <Border Width="420" MaxWidth="420" HorizontalAlignment="Left" VerticalAlignment="Stretch" Background="{StaticResource BlueVpnBg}"
                    Padding="20" BorderBrush="{StaticResource BlueVpnStroke}" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="حساب BlueVPN" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="✕" Click="CloseDrawers_Click" Width="42" Height="42" Padding="0"/>
                        </Grid>
                        <StackPanel x:Name="LoginPanel">
                            <!-- Android auth parity: dark authentication card, SMS/Email segmented mode,
                                 OTP step and Email login/register sub-mode. -->
                            <Border Background="#FF030405" CornerRadius="26" Padding="16" BorderBrush="#FF202126" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="ورود امن به BlueVPN" Foreground="White" FontSize="20" FontWeight="Bold" TextAlignment="Center"/>
                                    <TextBlock x:Name="AuthHintText" Text="ورود امن با کد یک‌بارمصرف ۶ رقمی" Foreground="#FFD8DEE9" FontSize="11.5"
                                               TextAlignment="Center" TextWrapping="Wrap" Margin="8,7,8,14"/>

                                    <Grid FlowDirection="LeftToRight" Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" x:Name="SmsModeButton" Content="پیامک" Click="AuthSmsMode_Click" Height="42" Margin="0,0,3,0"
                                                Background="#FF21140D" Foreground="#FFF97316" BorderBrush="#FFA9561F" FontWeight="Bold"/>
                                        <Button Grid.Column="1" x:Name="EmailModeButton" Content="ایمیل" Click="AuthEmailMode_Click" Height="42" Margin="3,0,0,0"
                                                Background="#FF101114" Foreground="#FFE5E7EB" BorderBrush="#FF697386" FontWeight="Bold"/>
                                    </Grid>

                                    <Border Background="#FF0F1012" CornerRadius="20" BorderBrush="#FF27272A" BorderThickness="1" Padding="16">
                                        <Grid>
                                            <StackPanel x:Name="SmsAuthPanel">
                                                <StackPanel x:Name="SmsPhoneStage">
                                                    <TextBlock Text="ورود به حساب کاربری" Foreground="White" FontSize="18" FontWeight="Bold"/>
                                                    <TextBlock Text="شماره موبایل خود را وارد کنید تا کد ورود ۶ رقمی برایتان ارسال شود."
                                                               Foreground="#FFD8DEE9" FontSize="11.5" TextWrapping="Wrap" Margin="0,7,0,16"/>
                                                    <TextBlock Text="شماره موبایل" Foreground="#FFD4D4D8" FontSize="11"/>
                                                    <TextBox x:Name="PhoneBox" FlowDirection="LeftToRight" TextAlignment="Left" MaxLength="14"
                                                             Background="#FF111827" Foreground="White" BorderBrush="#FF697386" CaretBrush="#FFF97316"
                                                             FontSize="15" Padding="13,11" Margin="0,7,0,8"/>
                                                    <Button Content="ارسال کد ورود" Click="RequestOtp_Click" Height="50" Margin="0,10,0,0"
                                                            Background="#FFFF8A1F" Foreground="#FF111827" BorderBrush="#FFEA580C" FontWeight="Bold"/>
                                                </StackPanel>

                                                <StackPanel x:Name="SmsOtpStage" Visibility="Collapsed">
                                                    <Button Content="→  تغییر شماره" Click="ChangePhone_Click" HorizontalAlignment="Left" Margin="0,0,0,8"
                                                            Background="Transparent" Foreground="#FFF97316" BorderBrush="Transparent" Padding="4" FontWeight="Bold"/>
                                                    <TextBlock Text="کد تأیید را وارد کنید" Foreground="White" FontSize="18" FontWeight="Bold"/>
                                                    <TextBlock x:Name="OtpTargetText" Text="کد ۶ رقمی ارسال‌شده را وارد کنید."
                                                               Foreground="#FFD8DEE9" FontSize="11.5" TextWrapping="Wrap" Margin="0,7,0,15"/>
                                                    <TextBox x:Name="OtpBox" FlowDirection="LeftToRight" TextAlignment="Center" MaxLength="6"
                                                             Background="#FF111827" Foreground="White" BorderBrush="#FF697386" CaretBrush="#FFF97316"
                                                             FontSize="25" FontWeight="Bold" CharacterCasing="Upper" Padding="13,11" Margin="0,0,0,8"/>
                                                    <Button Content="تأیید و ورود" Click="VerifyOtp_Click" Height="50" Margin="0,10,0,0"
                                                            Background="#FFFF8A1F" Foreground="#FF111827" BorderBrush="#FFEA580C" FontWeight="Bold"/>
                                                    <Button Content="کد را دریافت نکردید؟  ارسال مجدد" Click="ResendOtp_Click" Height="40" Margin="0,8,0,0"
                                                            Background="Transparent" Foreground="#FFF97316" BorderBrush="Transparent"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <StackPanel x:Name="EmailAuthPanel" Visibility="Collapsed">
                                                <Grid FlowDirection="LeftToRight" Margin="0,0,0,14">
                                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                                    <Button Grid.Column="0" x:Name="EmailLoginModeButton" Content="ورود" Click="EmailLoginMode_Click" Height="38" Margin="0,0,3,0"
                                                            Background="#FF21140D" Foreground="#FFF97316" BorderBrush="#FFA9561F" FontWeight="Bold"/>
                                                    <Button Grid.Column="1" x:Name="EmailRegisterModeButton" Content="ثبت‌نام" Click="EmailRegisterMode_Click" Height="38" Margin="3,0,0,0"
                                                            Background="#FF101114" Foreground="#FFE5E7EB" BorderBrush="#FF697386" FontWeight="Bold"/>
                                                </Grid>
                                                <TextBlock x:Name="EmailTitleText" Text="ورود با ایمیل" Foreground="White" FontSize="18" FontWeight="Bold"/>
                                                <TextBlock x:Name="EmailSubtitleText" Text="ایمیل و رمز عبور حساب BlueVPN خود را وارد کنید."
                                                           Foreground="#FFD8DEE9" FontSize="11.5" TextWrapping="Wrap" Margin="0,7,0,15"/>
                                                <TextBlock Text="ایمیل" Foreground="#FFD4D4D8" FontSize="11"/>
                                                <TextBox x:Name="EmailBox" FlowDirection="LeftToRight" TextAlignment="Left"
                                                         Background="#FF111827" Foreground="White" BorderBrush="#FF697386" CaretBrush="#FFF97316"
                                                         FontSize="14" Padding="13,11" Margin="0,7,0,10"/>
                                                <TextBlock Text="رمز عبور" Foreground="#FFD4D4D8" FontSize="11"/>
                                                <PasswordBox x:Name="PasswordBox" FlowDirection="LeftToRight"
                                                             Background="#FF111827" Foreground="White" BorderBrush="#FF697386" CaretBrush="#FFF97316"
                                                             FontSize="14" Padding="13,11" Margin="0,7,0,8"/>
                                                <Button x:Name="EmailSubmitButton" Content="ورود به BlueVPN" Click="EmailSubmit_Click" Height="50" Margin="0,10,0,0"
                                                        Background="#FFFF8A1F" Foreground="#FF111827" BorderBrush="#FFEA580C" FontWeight="Bold"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <TextBlock x:Name="AuthStatusText" Text="ورود روی همین دستگاه ذخیره می‌شود و اطلاعات اشتراک در پس‌زمینه همگام خواهد شد."
                                               Foreground="#FFB8C2D0" FontSize="10" TextAlignment="Center" TextWrapping="Wrap" Margin="8,13,8,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <StackPanel x:Name="AccountPanel" Visibility="Collapsed">
                            <Border Background="White" CornerRadius="18" BorderBrush="{StaticResource BlueVpnStroke}" BorderThickness="1" Padding="14">
                                <StackPanel><TextBlock x:Name="IdentityText" FontSize="17" FontWeight="Bold"/>
                                    <TextBlock x:Name="PlanText" Margin="0,7,0,0"/><TextBlock x:Name="ExpiryText" Foreground="{StaticResource BlueVpnMuted}" Margin="0,4,0,0"/>
                                    <TextBlock x:Name="TrafficText" Foreground="{StaticResource BlueVpnMuted}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                            <UniformGrid Columns="2" Margin="0,8,0,0"><Button Content="بروزرسانی حساب" Click="RefreshAccount_Click"/><Button Content="خروج" Click="Logout_Click"/></UniformGrid>
                        </StackPanel>
                        <TextBlock Text="پلن‌ها" FontSize="16" FontWeight="Bold" Margin="0,18,0,8"/>
                        <ItemsControl x:Name="PlansList"><ItemsControl.ItemTemplate><DataTemplate>
                            <Border Background="White" CornerRadius="14" BorderBrush="{StaticResource BlueVpnStroke}" BorderThickness="1" Padding="11" Margin="0,4">
                                <StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock FontSize="11" Foreground="{StaticResource BlueVpnMuted}"><Run Text="{Binding DurationDays}"/><Run Text=" روز • "/><Run Text="{Binding PriceToman}"/><Run Text=" تومان"/></TextBlock></StackPanel>
                            </Border>
                        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Settings/menu drawer -->
        <Grid x:Name="MenuDrawer" Visibility="Collapsed" Background="#66000000" Panel.ZIndex="21">
            <Border Width="360" MaxWidth="360" HorizontalAlignment="Right" VerticalAlignment="Stretch" Background="{StaticResource BlueVpnBg}"
                    Padding="20" BorderBrush="{StaticResource BlueVpnStroke}" BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="BlueVPN" FontSize="24" FontStyle="Italic" FontWeight="Bold" Foreground="{StaticResource BlueVpnBlue}"/>
                        <Button Grid.Column="1" Content="✕" Click="CloseDrawers_Click" Width="42" Height="42" Padding="0"/>
                    </Grid>
                    <Border Background="White" CornerRadius="18" BorderBrush="{StaticResource BlueVpnStroke}" BorderThickness="1" Padding="14">
                        <StackPanel><TextBlock Text="نسخه برنامه" FontSize="11" Foreground="{StaticResource BlueVpnMuted}"/>
