                    <Button x:Name="UpdateButton" Content="بررسی بروزرسانی" Click="Update_Click" Margin="0,12,0,0" Background="{StaticResource BlueVpnBlue}" Foreground="White"/>
                    <ProgressBar x:Name="UpdateProgressBar" Height="7" Minimum="0" Maximum="100" Value="0" Visibility="Collapsed" Margin="4,7,4,0"/>
