{
  "log": {
    "level": "warn",
    "timestamp": true
  },
  "inbounds": [
    {
      "type": "tun",
      "tag": "bluevpn-tun",
      "interface_name": "BlueVPN",
      "address": [
        "10.66.0.1/24",
        "fd66::1/64"
      ],
      "mtu": 1400,
      "auto_route": true,
      "strict_route": true,
      "stack": "system",
      "route_exclude_address": [
        "127.0.0.0/8",
        "::1/128"
      ]
    }
  ],
  "outbounds": [
    {
      "type": "socks",
      "tag": "xray-local",
      "server": "127.0.0.1",
      "server_port": 20808,
      "version": "5.3.7"
    },
    {
      "type": "direct",
      "tag": "direct"
    }
  ],
  "route": {
    "auto_detect_interface": true,
    "rules": [
      {
        "inbound": [
          "bluevpn-tun"
        ],
        "action": "sniff"
      },
      {
        "process_name": [
          "xray.exe"
        ],
        "action": "route",
        "outbound": "direct"
      },
      {
        "ip_is_private": true,
        "action": "route",
        "outbound": "direct"
      }
    ],
    "final": "xray-local"
  }
}
