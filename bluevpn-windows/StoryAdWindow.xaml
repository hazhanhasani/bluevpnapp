<Window x:Class="BlueVPN.Windows.StoryAdWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BlueVPN" Width="420" Height="650" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" FlowDirection="RightToLeft" ShowInTaskbar="False">
    <Border CornerRadius="26" Background="#FF0C111C" BorderBrush="#FF253957" BorderThickness="1" Padding="14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="4,2,4,12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="BlueVPN" FontWeight="Bold" FontSize="17" Foreground="White"/>
                    <TextBlock Text="پیشنهاد ویژه" Foreground="#FF91A3BE" FontSize="11"/>
                </StackPanel>
                <Button Grid.Column="1" x:Name="CloseButton" Content="×" Click="Close_Click" Width="34" Height="34" FontSize="20"/>
            </Grid>

            <Border Grid.Row="1" Background="#FF080D16" CornerRadius="18" ClipToBounds="True">
                <Grid>
                    <Image x:Name="StoryImage" Stretch="UniformToFill" Visibility="Collapsed"/>
                    <MediaElement x:Name="StoryVideo" Stretch="Uniform" LoadedBehavior="Manual" UnloadedBehavior="Stop" Visibility="Collapsed" MediaEnded="StoryVideo_MediaEnded"/>
                    <Border VerticalAlignment="Bottom" Background="#C9000000" Padding="18,22,18,18">
                        <StackPanel>
                            <TextBlock x:Name="StoryTitle" Foreground="White" FontSize="21" FontWeight="Bold" TextWrapping="Wrap"/>
                            <TextBlock x:Name="StorySubtitle" Foreground="#FFD7E3F4" FontSize="13" Margin="0,7,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Button Grid.Row="2" x:Name="ActionButton" Content="مشاهده" Click="Action_Click" Margin="0,12,0,0" Padding="16,12" FontWeight="SemiBold"/>
        </Grid>
    </Border>
</Window>
