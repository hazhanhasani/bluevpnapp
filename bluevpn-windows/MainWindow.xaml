<Window x:Class="BlueVPN.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BlueVPN" Height="820" Width="1180" MinHeight="740" MinWidth="1040"
        WindowStartupLocation="CenterScreen" FlowDirection="RightToLeft">
    <Grid Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="48" Height="48" CornerRadius="16" Background="{StaticResource BlueVpnBlue}" Margin="0,0,12,0">
                    <TextBlock Text="B" FontSize="25" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel>
                    <TextBlock Text="BlueVPN" FontSize="25" FontWeight="Bold"/>
                    <TextBlock Text="اتصال سریع، امن و یکپارچه" Foreground="{StaticResource BlueVpnMuted}" FontSize="11"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" FlowDirection="LeftToRight" VerticalAlignment="Center">
                <Button x:Name="UpdateButton" Content="بروزرسانی" Click="Update_Click"/>
                <Border Background="#FF111722" CornerRadius="12" Padding="12,8" Margin="4">
                    <StackPanel>
                        <TextBlock x:Name="VersionText" Text="v4.16.8" FontSize="11" Foreground="{StaticResource BlueVpnMuted}"/>
                        <TextBlock x:Name="CoreVersionText" Text="v2rayN" FontSize="10" Foreground="{StaticResource BlueVpnMuted}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="335"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource BlueVpnSurface}" CornerRadius="22" Padding="17">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="حساب BlueVPN" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
                        <StackPanel x:Name="LoginPanel">
                            <TextBlock Text="ایمیل" Foreground="{StaticResource BlueVpnMuted}"/><TextBox x:Name="EmailBox" FlowDirection="LeftToRight" TextAlignment="Left"/>
                            <TextBlock Text="رمز عبور" Foreground="{StaticResource BlueVpnMuted}"/><PasswordBox x:Name="PasswordBox" FlowDirection="LeftToRight"/>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="ورود" Click="Login_Click"/><Button Grid.Column="1" Content="ثبت‌نام" Click="Register_Click"/>
                            </Grid>
                            <Separator Margin="0,13" Background="#FF292E3B"/>
                            <TextBlock Text="ورود با پیامک" Foreground="{StaticResource BlueVpnMuted}"/>
                            <TextBox x:Name="PhoneBox" FlowDirection="LeftToRight" TextAlignment="Left"/>
                            <Button Content="ارسال کد" Click="RequestOtp_Click"/>
                            <TextBox x:Name="OtpBox" FlowDirection="LeftToRight" TextAlignment="Left"/>
                            <Button Content="تأیید و ورود" Click="VerifyOtp_Click"/>
                        </StackPanel>

                        <StackPanel x:Name="AccountPanel" Visibility="Collapsed">
                            <Border Background="{StaticResource BlueVpnCard2}" CornerRadius="16" Padding="13">
                                <StackPanel>
                                    <TextBlock x:Name="IdentityText" FontSize="16" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="PlanText" Margin="0,6,0,0"/>
                                    <TextBlock x:Name="ExpiryText" Foreground="{StaticResource BlueVpnMuted}" Margin="0,3,0,0"/>
                                    <TextBlock x:Name="TrafficText" Foreground="{StaticResource BlueVpnMuted}" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>
                            <Grid Margin="0,9,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="بروزرسانی حساب" Click="RefreshAccount_Click"/><Button Grid.Column="1" Content="خروج" Click="Logout_Click"/>
                            </Grid>
                        </StackPanel>

                        <Separator Margin="0,16" Background="#FF292E3B"/>
                        <TextBlock Text="پلن‌ها" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,7"/>
                        <ItemsControl x:Name="PlansList">
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <Border Background="{StaticResource BlueVpnCard2}" CornerRadius="12" Padding="10" Margin="0,3">
                                    <StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Foreground="{StaticResource BlueVpnMuted}" FontSize="11"><Run Text="{Binding DurationDays}"/><Run Text=" روز • "/><Run Text="{Binding PriceToman}"/><Run Text=" تومان"/></TextBlock></StackPanel>
                                </Border>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Background="{StaticResource BlueVpnSurface}" CornerRadius="22" Padding="20">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock x:Name="StatusText" Text="آماده اتصال" FontSize="19" FontWeight="SemiBold"/><TextBlock x:Name="ConnectionStatusText" Text="بهترین اتصال به‌صورت خودکار انتخاب می‌شود" Foreground="{StaticResource BlueVpnMuted}" FontSize="12"/></StackPanel>
                                <Border Grid.Column="1" Background="#FF20283A" CornerRadius="12" Padding="12,7"><TextBlock x:Name="TierText" Text="رایگان" Foreground="#FFB7C7E8"/></Border>
                            </Grid>

                            <Grid Grid.Row="1" Margin="0,22,0,20">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="250"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                    <Border x:Name="OrbHalo" Width="210" Height="210" CornerRadius="105" Background="#183978FF" Padding="27">
                                        <Border x:Name="StatusOrb" CornerRadius="80" Background="#FF171B25" BorderBrush="#FF3978FF" BorderThickness="2">
                                            <Button x:Name="ConnectButton" Content="⏻" Click="Connect_Click" FontSize="54" FontWeight="Light" Background="Transparent" BorderThickness="0" Margin="0"/>
                                        </Border>
                                    </Border>
                                    <TextBlock x:Name="OrbText" Text="برای اتصال کلیک کنید" HorizontalAlignment="Center" Margin="0,11,0,0" Foreground="{StaticResource BlueVpnMuted}"/>
                                </StackPanel>
                            </Grid>

                            <Border Grid.Row="2" Background="{StaticResource BlueVpnCard2}" CornerRadius="16" Padding="14" Margin="0,0,0,12">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock x:Name="EndpointText" Text="انتخاب خودکار بهترین مسیر" FontWeight="SemiBold"/><TextBlock x:Name="EngineText" Text="WARP رایگان • v2rayN برای سرویس‌ها" Foreground="{StaticResource BlueVpnMuted}" FontSize="11" Margin="0,4,0,0"/></StackPanel>
                                    <TextBlock Grid.Column="1" x:Name="LocationBadge" Text="AUTO" Foreground="{StaticResource BlueVpnBlue2}" VerticalAlignment="Center" FontWeight="Bold"/>
                                </Grid>
                            </Border>

                            <UniformGrid Grid.Row="3" Columns="4">
                                <Border Background="{StaticResource BlueVpnCard2}" CornerRadius="14" Padding="10" Margin="3"><StackPanel HorizontalAlignment="Center"><TextBlock Text="IP خروجی" Foreground="{StaticResource BlueVpnMuted}" FontSize="10"/><TextBlock x:Name="IpValue" Text="—" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel></Border>
                                <Border Background="{StaticResource BlueVpnCard2}" CornerRadius="14" Padding="10" Margin="3"><StackPanel HorizontalAlignment="Center"><TextBlock Text="Ping" Foreground="{StaticResource BlueVpnMuted}" FontSize="10"/><TextBlock x:Name="PingValue" Text="—" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel></Border>
                                <Border Background="{StaticResource BlueVpnCard2}" CornerRadius="14" Padding="10" Margin="3"><StackPanel HorizontalAlignment="Center"><TextBlock Text="مدت اتصال" Foreground="{StaticResource BlueVpnMuted}" FontSize="10"/><TextBlock x:Name="DurationValue" Text="00:00:00" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel></Border>
                                <Border Background="{StaticResource BlueVpnCard2}" CornerRadius="14" Padding="10" Margin="3"><StackPanel HorizontalAlignment="Center"><TextBlock Text="سرعت" Foreground="{StaticResource BlueVpnMuted}" FontSize="10"/><TextBlock x:Name="SpeedValue" Text="0 KB/s" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel></Border>
                            </UniformGrid>
                        </Grid>
                    </Border>

                    <Border x:Name="AdCard" Background="#FF121A2A" CornerRadius="18" Padding="0" Margin="0,14,0,0" Visibility="Collapsed" MouseLeftButtonUp="AdCard_Click" Cursor="Hand" ClipToBounds="True">
                        <Grid Height="150">
                            <Image x:Name="AdImage" Stretch="UniformToFill"/>
                            <Border Background="#B5000000" VerticalAlignment="Bottom" Padding="15,14">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock x:Name="AdTitle" FontSize="16" FontWeight="Bold"/><TextBlock x:Name="AdSubtitle" Foreground="#FFD0DBEB" FontSize="11" TextWrapping="Wrap"/></StackPanel>
                                    <TextBlock Grid.Column="1" x:Name="AdActionText" Text="مشاهده ←" Foreground="#FFAEC3FF" VerticalAlignment="Center" Margin="15,0,0,0"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Background="{StaticResource BlueVpnSurface}" CornerRadius="18" Padding="14" Margin="0,14,0,0">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="وضعیت اتصال" FontWeight="SemiBold"/><TextBlock x:Name="TechnicalText" Text="در حال بررسی هسته اتصال…" Foreground="{StaticResource BlueVpnMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel>
                            <TextBlock Grid.Column="1" x:Name="RuntimeBadge" Text="v2rayN" Foreground="{StaticResource BlueVpnGreen}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Grid Grid.Row="2" Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="FooterStatus" Text="آماده" Foreground="{StaticResource BlueVpnMuted}"/>
            <TextBlock Grid.Column="1" Text="BlueVPN Windows • System-wide VPN" Foreground="{StaticResource BlueVpnMuted}"/>
        </Grid>
    </Grid>
</Window>
