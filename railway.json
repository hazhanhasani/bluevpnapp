{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": [
      "Dockerfile",
      "requirements.txt",
      "server/**",
      "railway.json"
    ]
  },
  "deploy": {
    "healthcheckPath": "/live",
    "healthcheckTimeout": 60,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "startCommand": "/bin/sh -c \"export PYTHONPATH=/app; exec python /app/server/run_combined.py\""
  }
}
