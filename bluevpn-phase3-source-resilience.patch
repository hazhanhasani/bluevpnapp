+    def test_phase3_roadmap_has_circuit_breaker_and_safe_rollout(self):
+        doc=self.text("bluevpn-gateway/PHASE3.md")
+        self.assertIn("circuit-breaker",doc)
+        self.assertIn("config-generation acknowledgement",doc)
