FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       git \
       ca-certificates \
       curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt /tmp/requirements.txt

RUN pip install --no-cache-dir -r /tmp/requirements.txt \
    && pip install --no-cache-dir \
       "python-telegram-bot>=21,<23" \
       "httpx>=0.27,<1"

COPY . /app

RUN mkdir -p /opt/bluevpn_bot \
    && python -c "import base64; open('/opt/bluevpn_bot/deploy_bot.py','wb').write(base64.b64decode(''))" \
    && python -c "import base64; open('/opt/bluevpn_bot/run.py','wb').write(base64.b64decode(''))"

CMD ["python", "/opt/bluevpn_bot/run.py"]
